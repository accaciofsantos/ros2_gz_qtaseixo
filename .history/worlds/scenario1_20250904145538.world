<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="scenario1_world">

    <!-- Física -->
    <physics type="ode">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <gravity>0 0 -9.8</gravity>
    </physics>

    <!-- Luz -->
    <light name="sun" type="directional">
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.5 -1</direction>
    </light>

    <!-- Cena -->
    <scene>
      <ambient>1 1 1 1</ambient>
      <background>0.5 0.7 1 1</background>
      <grid>false</grid>
    </scene>

    <!-- Modelo base da árvore -->
    <model name="oak_base">
      <pose>0 0 0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="trunk">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>1.5</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.55 0.27 0.07 1</ambient>
          </material>
        </visual>
        <visual name="leaves">
          <pose>0 0 1.25 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.5</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0 0.5 0 1</ambient>
          </material>
        </visual>
        <collision name="trunk_collision">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>1.5</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Geração das árvores: 3 fileiras x 10 árvores -->
    <!-- Fileira 1: y = 0 -->
    <include><uri>model://oak_base</uri><name>oak_1_0</name><pose>0 0 0 0 0 0</pose></include>
    <include><uri>model://oak_base</uri><name>oak_1_1</name><pose>1 0 0 0 0 0</pose></include>
    <include><uri>model://oak_base</uri><name>oak_1_2</name><pose>2 0 0 0 0 0</pose></include>
    <include><uri>model://oak_base</uri><name>oak_1_3</name><pose>3 0 0 0 0 0</pose></include>
    <include><uri>model://oak_base</uri><name>oak_1_4</name><pose>4 0 0 0 0 0</pose></include>
    <include><uri>model://oak_base</uri><name>oak_1_5</name><pose>5 0 0 0 0 0</pose></include>
    <include><uri>model://oak_base</uri><name>oak_1_6</name><pose>6 0 0 0 0 0</pose></include>
    <include><uri>model://oak_base</uri><name>oak_1_7</name><pose>7 0 0 0 0 0</pose></include>
    <include><uri>model://oak_base</uri><name>oak_1_8</name><pose>8 0 0 0 0 0</pose></include>
    <include><uri>model://oak_base</uri><name>oak_1_9</name><pose>9 0 0 0 0 0</pose></include>

    <!-- Fileira 2: y = 1.5 -->
    <include><uri>model://oak_base</uri><name>oak_2_0</name><pose>0 1.5 0 0 0 0</pose></include>
    <include><uri>model://oak_base</uri><name>oak_2_1</name><pose>1 1.5 0 0 0 0</pose></include>
    <include><uri>model://oak_base</uri><name>oak_2_2</name><pose>2 1.5 0 0 0 0</pose></include>
    <include><uri>model://oak_base</uri><name>oak_2_3</name><pose>3 1.5 0 0 0 0</pose></include>
    <include><uri>model://oak_base</uri><name>oak_2_4</name><pose>4 1.5 0 0 0 0</pose></include>
    <include><uri>model://oak_base</uri><name>oak_2_5</name><pose>5 1.5 0 0 0 0</pose></include>
    <include><uri>model://oak_base</uri><name>oak_2_6</name><pose>6 1.5 0 0 0 0</pose></include>
    <include><uri>model://oak_base</uri><name>oak_2_7</name><pose>7 1.5 0 0 0 0</pose></include>
    <include><uri>model://oak_base</uri><name>oak_2_8</name><pose>8 1.5 0 0 0 0</pose></include>
    <include><uri>model://oak_base</uri><name>oak_2_9</name><pose>9 1.5 0 0 0 0</pose></include>

    <!-- Fileira 3: y = 3.0 -->
    <include><uri>model://oak_base</uri><name>oak_3_0</name><pose>0 3.0 0 0 0 0</pose></include>
    <include><uri>model://oak_base</uri><name>oak_3_1</name><pose>1 3.0 0 0 0 0</pose></include>
    <include><uri>model://oak_base</uri><name>oak_3_2</name><pose>2 3.0 0 0 0 0</pose></include>
    <include><uri>model://oak_base</uri><name>oak_3_3</name><pose>3 3.0 0 0 0 0</pose></include>
    <include><uri>model://oak_base</uri><name>oak_3_4</name><pose>4 3.0 0 0 0 0</pose></include>
    <include><uri>model://oak_base</uri><name>oak_3_5</name><pose>5 3.0 0 0 0 0</pose></include>
    <include><uri>model://oak_base</uri><name>oak_3_6</name><pose>6 3.0 0 0 0 0</pose></include>
    <include><uri>model://oak_base</uri><name>oak_3_7</name><pose>7 3.0 0 0 0 0</pose></include>
    <include><uri>model://oak_base</uri><name>oak_3_8</name><pose>8 3.0 0 0 0 0</pose></include>
    <include><uri>model://oak_base</uri><name>oak_3_9</name><pose>9 3.0 0 0 0 0</pose></include>

  </world>
</sdf>
