<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="scenario1_world">
    <physics type="ode">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <gravity>0 0 -9.8</gravity>
    </physics>

    <!-- Cena -->
    <scene>
      <ambient>1 1 1 1</ambient>
      <background>0.3 0.7 0.9 1</background>
      <shadows>1</shadows>
      <grid>false</grid>
      <user_camera>
        <pose>-5 -5 10 0 -1.57 0</pose>
      </user_camera>
    </scene>

    <!-- Luz do sol -->
    <light name="sun" type="directional">
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.5 -1.0</direction>
    </light>

    <!-- Loop manual para 3 fileiras x 10 árvores -->
    <!-- Distância entre árvores: 1.0m -->
    <!-- Distância entre fileiras: 1.5m -->

    <!-- Fileira 1 -->
    <model name="oak_1_1"><pose>0 0 0 0 0 0</pose></model>
    <model name="oak_1_2"><pose>1 0 0 0 0 0</pose></model>
    <model name="oak_1_3"><pose>2 0 0 0 0 0</pose></model>
    <model name="oak_1_4"><pose>3 0 0 0 0 0</pose></model>
    <model name="oak_1_5"><pose>4 0 0 0 0 0</pose></model>
    <model name="oak_1_6"><pose>5 0 0 0 0 0</pose></model>
    <model name="oak_1_7"><pose>6 0 0 0 0 0</pose></model>
    <model name="oak_1_8"><pose>7 0 0 0 0 0</pose></model>
    <model name="oak_1_9"><pose>8 0 0 0 0 0</pose></model>
    <model name="oak_1_10"><pose>9 0 0 0 0 0</pose></model>

    <!-- Fileira 2 -->
    <model name="oak_2_1"><pose>0 1.5 0 0 0 0</pose></model>
    <model name="oak_2_2"><pose>1 1.5 0 0 0 0</pose></model>
    <model name="oak_2_3"><pose>2 1.5 0 0 0 0</pose></model>
    <model name="oak_2_4"><pose>3 1.5 0 0 0 0</pose></model>
    <model name="oak_2_5"><pose>4 1.5 0 0 0 0</pose></model>
    <model name="oak_2_6"><pose>5 1.5 0 0 0 0</pose></model>
    <model name="oak_2_7"><pose>6 1.5 0 0 0 0</pose></model>
    <model name="oak_2_8"><pose>7 1.5 0 0 0 0</pose></model>
    <model name="oak_2_9"><pose>8 1.5 0 0 0 0</pose></model>
    <model name="oak_2_10"><pose>9 1.5 0 0 0 0</pose></model>

    <!-- Fileira 3 -->
    <model name="oak_3_1"><pose>0 3.0 0 0 0 0</pose></model>
    <model name="oak_3_2"><pose>1 3.0 0 0 0 0</pose></model>
    <model name="oak_3_3"><pose>2 3.0 0 0 0 0</pose></model>
    <model name="oak_3_4"><pose>3 3.0 0 0 0 0</pose></model>
    <model name="oak_3_5"><pose>4 3.0 0 0 0 0</pose></model>
    <model name="oak_3_6"><pose>5 3.0 0 0 0 0</pose></model>
    <model name="oak_3_7"><pose>6 3.0 0 0 0 0</pose></model>
    <model name="oak_3_8"><pose>7 3.0 0 0 0 0</pose></model>
    <model name="oak_3_9"><pose>8 3.0 0 0 0 0</pose></model>
    <model name="oak_3_10"><pose>9 3.0 0 0 0 0</pose></model>

    <!-- Definição de cada árvore -->
    <model name="oak_base">
      <pose>0 0 0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <!-- Tronco -->
        <visual name="trunk">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>1.5</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.55 0.27 0.07 1</ambient>
          </material>
        </visual>
        <collision name="trunk_collision">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>1.5</length>
            </cylinder>
          </geometry>
        </collision>
        <!-- Copa -->
        <visual name="leaves">
          <pose>0 0 1.25 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.5</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0 0.5 0 1</ambient>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
