<?xml version="1.0"?>
<sdf version="1.6">
  <model name="low_poly_tree">
    <static>true</static>

    <link name="link">
      <pose>0 0 0 1.5708 0 0</pose> <!-- rotaciona para ficar em pé -->

      <!-- Visual -->
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>file:///home/criis/ros2_ws/src/ros2_gz_qtaseixo/models/low_poly_tree/Lowpoly_tree_sample.obj</uri>
            <scale>0.1 0.1 0.1</scale>
          </mesh>
        </geometry>
      </visual>

      <!-- Colisão ajustada -->
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.15</radius>   <!-- cobre o tronco + copa aproximada -->
            <length>1.0</length>    <!-- altura total da árvore com escala -->
          </cylinder>
        </geometry>
        <pose>0 0 0.5 0 0 0</pose> <!-- centraliza o cilindro na base -->
      </collision>

    </link>
  </model>
</sdf>
