<?xml version="1.0"?>
<sdf version="1.9">
  <world name="variable_friction_world">

    <!-- ================= SKY & LIGHT ================ -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Sun</uri>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Sky</uri>
    </include>

    <!-- ================== GROUND 1 ================== -->
    <model name="low_friction_area">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>

      <link name="ground_low">
        <collision name="collision">
          <geometry>
            <box><size>15 15 0.1</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.1</mu>
                <mu2>0.1</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <visual name="visual">
          <geometry>
            <box><size>15 15 0.1</size></box>
          </geometry>
          <material>
            <diffuse>0.7 0.8 1 1</diffuse> <!-- azul claro -->
          </material>
        </visual>
      </link>
    </model>

    <!-- ================== GROUND 2 ================== -->
    <model name="medium_friction_area">
      <static>true</static>
      <pose>15 0 0 0 0 0</pose>

      <link name="ground_mid">
        <collision name="collision">
          <geometry>
            <box><size>15 15 0.1</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.5</mu>
                <mu2>0.5</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <visual name="visual">
          <geometry>
            <box><size>15 15 0.1</size></box>
          </geometry>
          <material>
            <diffuse>0.6 1 0.6 1</diffuse> <!-- verde -->
          </material>
        </visual>
      </link>
    </model>

    <!-- ================== GROUND 3 ================== -->
    <model name="high_friction_area">
      <static>true</static>
      <pose>30 0 0 0 0 0</pose>

      <link name="ground_high">
        <collision name="collision">
          <geometry>
            <box><size>15 15 0.1</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <visual name="visual">
          <geometry>
            <box><size>15 15 0.1</size></box>
          </geometry>
          <material>
            <diffuse>1 0.6 0.6 1</diffuse> <!-- vermelho claro -->
          </material>
        </visual>
      </link>
    </model>

    <!-- ================== SLOPE 10° ================= -->
    <model name="slope_10_deg">
      <static>true</static>
      <pose>0 20 0 0 0.17 0</pose> <!-- 0.17 rad = 10° -->

      <link name="slope10">
        <collision name="collision">
